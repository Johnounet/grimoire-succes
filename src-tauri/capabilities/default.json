{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions de la fenêtre principale et de la fenêtre compacte",
  "windows": ["main", "compact"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "steam://open/console" },
        { "url": "https://github.com/Johnounet/grimoire-succes*" },
        { "url": "https://www.youtube.com/results?*" },
        { "url": "https://www.google.com/search?*" },
        { "url": "https://steamcommunity.com/app/*/guides/*" }
      ]
    },
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-is-registered"
  ]
}
